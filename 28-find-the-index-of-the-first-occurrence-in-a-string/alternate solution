//alternate soolution. 

class Solution {
    public int strStr(String s, String p) {
        int n = s.length(), m = p.length();
        if (m == 0) return 0;
        if (m > n) return -1;

        int[] lps = new int[m];

        for (int i = 1, j = 0; i < m;) {
            if (p.charAt(i) == p.charAt(j)) {
                lps[i++] = ++j;
            } else if (j > 0) {
                j = lps[j - 1];
            } else {
                i++;
            }
        }

        for (int i = 0, j = 0; i < n;) {
            if (s.charAt(i) == p.charAt(j)) {
                if (++j == m) return i - m + 1;
                i++;
            } else if (j > 0) {
                j = lps[j - 1];
            } else {
                i++;
            }
        }

        return -1;
    }
}
